{
  "name": "wonderlens",
  "version": "1.0.0",
  "private": true,
  "description": "Family photo quest companion for a day at the Disneyland Resort",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "phone": "node scripts/open-on-phone.mjs",
    "build": "node scripts/build-www.js",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npm run cap:sync && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}

